# docker compose 使用的配置，复制为 .env 后修改
JWT_SECRET=please-change-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=please-change-me
POSTGRES_PASSWORD=gametrans
# 是否开放注册
ALLOW_REGISTRATION=true
# everyone：任何登录用户都可创建项目；superadmin：仅超级管理员
PROJECT_CREATION=everyone
# 通过 HTTPS 访问时设为 true
COOKIE_SECURE=false
APP_PORT=3000
