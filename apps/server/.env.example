# PostgreSQL（数据库需使用 UTF-8 的 LC_CTYPE，翻译记忆的中日韩模糊匹配依赖它）
DATABASE_URL=postgresql://gametrans:gametrans@localhost:5432/gametrans
REDIS_URL=redis://localhost:6379
# 用于签发登录凭证，生产环境务必修改
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# 上传文件与导出包的存放目录
STORAGE_DIR=./storage
# 启动时自动创建的超级管理员（仅在该用户名不存在时创建）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
# 生产环境：构建后的前端目录，由后端直接托管
# STATIC_DIR=../web/dist
# 单次上传大小上限（MB）
UPLOAD_LIMIT_MB=2048
# 登录 Cookie 是否仅在 HTTPS 下发送
COOKIE_SECURE=false
# 是否开放在线 API 文档（/api/docs）
API_DOCS=true
