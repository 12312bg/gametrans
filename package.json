{
  "name": "gametrans",
  "private": true,
  "version": "0.1.0",
  "description": "RPG Maker 本地化在线协作平台",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:libs": "pnpm --filter @gametrans/shared build && pnpm --filter @gametrans/rpgmaker build",
    "build": "pnpm build:libs && pnpm --filter @gametrans/server build && pnpm --filter @gametrans/web build",
    "dev:server": "pnpm --filter @gametrans/server dev",
    "dev:web": "pnpm --filter @gametrans/web dev",
    "test": "pnpm --filter @gametrans/shared --filter @gametrans/rpgmaker --filter @gametrans/web test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @gametrans/server prisma:migrate",
    "db:deploy": "pnpm --filter @gametrans/server prisma:deploy",
    "test:e2e": "pnpm build && pnpm --filter @gametrans/e2e test"
  }
}
